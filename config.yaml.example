logging:
  dir: "./logs"
  level: "INFO"

crawler:
  output_dir: "./droidbot_out"
  policy: "dfs_greedy"        # dfs_greedy | bfs_greedy | dfs_naive | bfs_naive
  # Exhaustive coverage needs a real budget. 600s is ~600 events at interval 1,
  # nowhere near enough for a camera app. Use -1 for no time limit and bound
  # the run with `count` instead.
  timeout: -1
  count: 20000
  interval: 1
  grant_perm: true
  clear_app_data: true        # deterministic start state; runs stay comparable
  is_emulator: false
  apk_cache_dir: "./temp_apks"
  # Set this only if you have a standalone APK. Otherwise the base APK is
  # pulled from the device automatically via `adb pull`.
  apk_path: null

parser:
  # Defaults to crawler.output_dir when omitted.
  utg_file: "utg.js"
  events_subdir: "events"
  states_subdir: "states"
  fallback_to_class: true
  # Jetpack Compose emits bare clickable `android.view.View` wrappers whose
  # label lives on a child node. Without this, every Compose control collapses
  # to the useless selector `className "View"`.
  resolve_descendant_labels: true
  max_descendant_depth: 4
  strict: true
  selector_priority:
    - text
    - content_description
    - resource_id

generator:
  uvta_output: "./out/com.sec.android.app.camera_suite.uvta"
  verify_timeout: 2.0
  verify_after_each_step: true
  max_path_depth: 0           # 0 = unlimited
  validate: true

coverage:
  report_dir: "./reports"
  baseline_file: "./reports/baseline.json"
  min_activity_coverage: 90.0 # gate fails below this
  fail_on_regression: true

llm:
  # The LLM only renames testcases. It never affects test steps.
  enabled: false
  api_style: "ollama"         # ollama | openai
  timeout: 120
